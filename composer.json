{
  "name": "webman-tech/laravel-cache",
  "type": "library",
  "license": "MIT",
  "description": "Webman plugin webman-tech/laravel-cache",
  "require": {
    "php": "^8.3",
    "illuminate/cache": "^13.0",
    "illuminate/config": "^13.0",
    "illuminate/events": "^13.0",
    "webman-tech/common-utils": "^5.0 || dev-main"
  },
  "_comment": [
    "symfony/cache for psr16"
  ],
  "autoload": {
    "psr-4": {
      "WebmanTech\\LaravelCache\\": ""
    },
    "files": [
      "helper.php"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "suggest": {
    "webman-tech/laravel-database": "使用 database 缓存 store 时需要（或向容器绑定 Illuminate\\Database\\ConnectionResolverInterface）",
    "webman-tech/laravel-redis": "使用 redis 缓存 store 及限流中间件时需要（或向容器绑定 Illuminate\\Contracts\\Redis\\Factory）"
  }
}
